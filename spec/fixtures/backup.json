{
  "about": "Nouride's files as one zip: what under .nouride stays out of it, the zip's name, and the database snapshot it carries. See spec/backup.md. `out` is the list both apps hold; a path ending in / is a folder. A case's `expect` is both apps' answer; `android` or `desktop`, when present, is that app's own where the two differ today.",
  "entries": {
    "folder": ".nouride/",
    "database": ".nouride/data/nouride.db"
  },
  "out": [
    {
      "pattern": "data/secrets.enc",
      "why": "the secret store"
    },
    {
      "pattern": "data/secrets.json",
      "why": "the secret store of before 0.8.19, or written for a rollback, in the clear"
    },
    {
      "pattern": "encryption.key",
      "why": "the secret store's key, where Nouride made it in its own folder"
    },
    {
      "pattern": "data/.control-token",
      "why": "the key to Nouride's control routes"
    },
    {
      "pattern": "credentials/",
      "why": "credentials kept as files"
    },
    {
      "pattern": "home/",
      "why": "the agents' home: their sign-ins, keys and tool caches"
    },
    {
      "pattern": "workspace/private/*/.cli/",
      "why": "the coding tools' sign-ins"
    },
    {
      "pattern": "data/whatsapp/",
      "why": "the WhatsApp session"
    },
    {
      "pattern": "data/appliance/",
      "why": "a Box's identity"
    },
    {
      "pattern": "data/cli-accounts.json",
      "why": "the coding tools' accounts of before 0.8.18"
    },
    {
      "pattern": "nougate/",
      "why": "the LLM gateway: its accounts, its session secret and its own open database"
    },
    {
      "pattern": "data/nouride.*",
      "why": "the open database with its -wal, -shm and epoch, a database a restore set aside, the log, the lock"
    },
    {
      "pattern": "data/backups/",
      "why": "the snapshots Nouride keeps"
    },
    {
      "pattern": "bin/",
      "why": "tools Nouride installs"
    },
    {
      "pattern": "lib/",
      "why": "npm's global packages"
    },
    {
      "pattern": "opt/",
      "why": "installs of Bun, uv, pipx and Python"
    },
    {
      "pattern": "share/",
      "why": "what those installs share"
    },
    {
      "pattern": "system-packages/",
      "why": "a container's package cache"
    },
    {
      "pattern": ".crates.toml",
      "why": "cargo's record of its installs"
    },
    {
      "pattern": ".crates2.json",
      "why": "cargo's record of its installs"
    },
    {
      "pattern": "**/node_modules/",
      "why": "a project's dependencies, installed again from its lock"
    },
    {
      "pattern": "**/.venv/",
      "why": "a Python environment, made again from its requirements"
    },
    {
      "pattern": "**/__pycache__/",
      "why": "Python's compiled cache"
    },
    {
      "pattern": "jobs/",
      "why": "background jobs' output"
    },
    {
      "pattern": "tool-output/",
      "why": "large tool output, swept after two days"
    },
    {
      "pattern": "data/knowledge/",
      "why": "the document reader's cache"
    },
    {
      "pattern": "data/clean-shutdown.json",
      "why": "the marker of a clean stop"
    },
    {
      "pattern": "workspace/private/*/.scratchpad/",
      "why": "an agent's scratch folder, swept after three days"
    }
  ],
  "kept": [
