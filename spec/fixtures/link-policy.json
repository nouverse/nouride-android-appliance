      "url": "https://nouride.example.com/dashboard/",
      "origin": "https://nouride.example.com",
      "expect": true
    },
    {
      "url": "https://elsewhere.example.com/dashboard/",
      "origin": "https://nouride.example.com",
      "expect": false
    },
    {
