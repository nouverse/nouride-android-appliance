{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nouride Home",
  "version": "0.2.0",
  "identifier": "tech.nouverse.nouride.home",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nouride Home",
        "width": 980,
        "height": 640,
        "minWidth": 560,
        "minHeight": 520,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/nouverse/nouride-appliance-desktop/releases/latest/download/latest.json"],
      "pubkey": ""
    },
    "deep-link": {
      "desktop": {
        "schemes": ["nouridehome"]
      }
    }
  }
}
